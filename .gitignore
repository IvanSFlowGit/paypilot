# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Secrets / local config
.env

# RAG vector store is built in memory from data/playbook.md (nothing to ignore)

# Recovery-loop state. Real customer invoice/recovery data - never committed.
# The -wal/-shm siblings come from SQLite's WAL journal mode.
data/paypilot.db
data/paypilot.db-wal
data/paypilot.db-shm


# Internal adversarial-review notes. Working notes about where this codebase has
# been weak are exactly what an attacker would read first, so they stay local.
HANDOFF.md

# Generated template drafts await human review; only the reviewed artifact is committed.
data/templates/*.draft.json

# Demo-run ledger. Contains Stripe ids and recovery state; never committed.
data/demo-loop.db
data/demo-loop.db-wal
data/demo-loop.db-shm
data/last-recovery-link.txt

# Copy-detection findings (attacker-authored data, never committed)
canary-findings.json
canary-findings.json.tmp

# RUNTIME DATA NEVER ENTERS THE REPOSITORY.
# Checked 2026-08-13: five SQLite databases totalling ~1.3MB sat here untracked but
# NOT IGNORED - protection by accident, which holds until somebody runs git add -A.
# Contents were verified synthetic at the time (zero email addresses across all five),
# so nothing leaked. That is luck about timing, not a property of the setup: the day
# real failure data lands in paypilot.db it would go to GitHub with the rest.
data/*.db
data/*.db-shm
data/*.db-wal
data/*.json
