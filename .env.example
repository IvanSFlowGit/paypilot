# PayPilot - environment template
# Copy to `.env` and fill in your key:  cp .env.example .env
# Note: tests mock the LLM and retriever, so no key/network is needed to run pytest.

# Your OpenAI API key (used by ChatOpenAI for diagnosis/draft and by OpenAIEmbeddings for RAG)
OPENAI_API_KEY=

# Chat model for the LangGraph nodes (overrides the gpt-4o-mini default in get_llm())
OPENAI_MODEL=gpt-4o-mini

# Langfuse tracing (optional). Set both keys to trace recovery runs to Langfuse;
# leave blank to disable tracing entirely (run_recovery is unchanged). Keys: Langfuse
# UI > Settings > API Keys. Never commit real keys - keep them in .env only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Stripe (the recovery loop) -------------------------------------------
# Restricted key. At runtime the app makes exactly ONE kind of Stripe call:
# billing_portal.Session.create. Everything else arrives in the signed
# webhook. So: billing portal sessions WRITE, plus invoices READ and
# customers READ for headroom. Never write access to invoices - this is a
# revenue system and the key should not be able to alter one.
STRIPE_API_KEY=
# Signing secret for the webhook destination. Subscribe it to exactly four
# events: invoice.payment_failed, invoice.paid, invoice.payment_succeeded,
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the customer after they update their card.
PAYPILOT_PORTAL_RETURN_URL=

PAYPILOT_ENV=

# Webhook signature verification is MANDATORY by default: with no
# STRIPE_WEBHOOK_SECRET set, every event is rejected with a 400. An unsigned
# endpoint that writes to the recovery ledger lets anyone forge a recovery,
# choose the amount, and pick who gets emailed. This escape hatch exists only
# for a credential-free public demo. Never set it on a real deployment.
PAYPILOT_ALLOW_UNSIGNED_WEBHOOKS=

# Send limits. These are business-level dedup, separate from webhook
# idempotency: idempotency stops one delivery being processed twice, while
# these stop several DIFFERENT valid events mailing the same human at once.
PAYPILOT_MAX_TOUCHES=3
PAYPILOT_SEND_COOLDOWN_HOURS=24

# --- Recovery ledger ------------------------------------------------------
# SQLite file holding failed invoices and their recovery state. On Fly this
# must point at a mounted volume or every deploy wipes the history.
PAYPILOT_DB_PATH=

# --- Email delivery -------------------------------------------------------
RESEND_API_KEY=
PAYPILOT_FROM_EMAIL=PayPilot <billing@yourdomain.com>
# Signs every dunning email. YOUR business name, not PayPilot's: the
# recipient is your customer and has never heard of the tool.
PAYPILOT_BUSINESS_NAME=
# Sending is a dry run unless this is exactly "1". The dry run records what
# would have gone out, so the loop is fully exercisable without mailing anyone.
PAYPILOT_SEND_EMAIL=
# Comma-separated addresses cleared to receive real mail. UNSET MEANS NOBODY.
# A Stripe test-mode customer can carry a real person's address, and "it was
# only test mode" is no comfort to someone who got a dunning email. Use "*" to
# disable the catch, which has to be written out deliberately.
PAYPILOT_ALLOWED_RECIPIENTS=

# Hosts allowed to appear as links in dunning copy. Unset uses Stripe's hosted
# domains. Setting it REPLACES that default, so a client deployment can narrow
# the allowlist to exactly its own domains.
PAYPILOT_ALLOWED_LINK_HOSTS=
