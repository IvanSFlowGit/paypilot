# Terraform state holds the database password and the API token in plaintext
# (they are read from SSM at plan time). It never enters the repository.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# A saved plan (terraform plan -out) embeds the same secrets as state.
*.tfplan
tfplan
crash.log
# Build output: the Lambda zip and its staging directory.
build/
